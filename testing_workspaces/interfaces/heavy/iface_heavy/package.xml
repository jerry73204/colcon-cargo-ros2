<?xml version="1.0"?>
<package format="3">
  <name>iface_heavy</name>
  <version>0.1.0</version>
  <description>Definitions borrowed from third-party interface packages that a stock ROS install does not ship. Outside src/ so the base tier never needs rosdep; built by `just build-heavy`.</description>
  <maintainer email="jerry73204@gmail.com">Lin Hsiang-Jui</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>test_msgs</depend>
  <depend>nav2_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
